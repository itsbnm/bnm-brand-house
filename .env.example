# Paystack secret key from the dashboard. Server only. Never put this in the browser.
PAYSTACK_SECRET_KEY=
# USD matches the prices on the site. Use NGN only if the catalogue is priced in naira.
PAYSTACK_CURRENCY=USD

# Required on Vercel. The public default password is refused there until both are set.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Public site origin used in metadata. The live app is https://bnm-brand-house.vercel.app until the domain is connected.
# NEXT_PUBLIC_SITE_URL=https://www.bnmbrandhouse.com
